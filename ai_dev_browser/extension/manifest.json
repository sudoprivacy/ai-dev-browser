{
  "manifest_version": 3,
  "name": "AI Dev Browser — bridge",
  "version": "0.1.0",
  "description": "Lets ai-dev-browser drive THIS Chrome (your real profile) via chrome.debugger over a local bridge. Opt-in; only active while ai-dev-browser is connected.",
  "minimum_chrome_version": "116",
  "permissions": ["debugger", "tabs", "alarms"],
  "host_permissions": ["<all_urls>"],
  "icons": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
  "action": {
    "default_title": "AI Dev Browser bridge",
    "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" }
  },
  "background": { "service_worker": "background.js" }
}
